diff --git a/tonkai/piece_safety.py b/tonkai/piece_safety.py
index bcf288d..f9e5e52 100644
--- a/tonkai/piece_safety.py
+++ b/tonkai/piece_safety.py
@@ -211,6 +211,23 @@ def position_risk(rows, colour):
     return min(1.0, max(risks, default=0.0) + .05 * sum(risks))
 
 
+def positive_exchange_signals(rows, colour):
+    """Best profitable threat and protection against the best enemy exchange.
+
+    Both terms are in [0, 1] and use the same pawn-value scale. A nominal
+    attack that loses material contributes nothing to the threat term.
+    """
+    own = "w" if colour else "b"
+    enemy = "b" if colour else "w"
+    threat = max((max(0.0, -row["exchange_balance"])
+                  for row in rows if row["color"] == enemy and row["exchange_balance"] is not None),
+                 default=0.0)
+    exposed = max((max(0.0, -row["exchange_balance"])
+                   for row in rows if row["color"] == own and row["exchange_balance"] is not None),
+                  default=0.0)
+    return threat / (threat + 3.0), 3.0 / (exposed + 3.0)
+
+
 def pawn_unit(raw_values, pieces, floor=.001):
     """Robust local scale; not a calibrated classical pawn/centipawn estimate."""
     values = sorted(abs(float(v)) for v, p in zip(raw_values, pieces) if p.piece_type == chess.PAWN and math.isfinite(v))
